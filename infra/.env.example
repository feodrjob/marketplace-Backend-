# Copy to /opt/marketplace/.env on the VPS.
# Preserve the credentials of the existing PostgreSQL database.
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=
POSTGRES_DB=marketplace

APP_DOMAIN=87.242.102.190.nip.io
AUTH_IMAGE=ghcr.io/feodrjob/marketplace-auth:latest
CATALOG_IMAGE=ghcr.io/feodrjob/marketplace-catalog:latest
FRONTEND_IMAGE=ghcr.io/feodrjob/marketplace-frontend:latest

# Generate once on the VPS: openssl rand -hex 32
AUTH_JWT_SECRET=

# Keep disabled until catalog startup and HTTP API are ready.
CATALOG_REPLICAS=0

